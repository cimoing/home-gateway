# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS node

FROM golang:1.25-bookworm AS development

COPY --from=node /usr/local/ /usr/local/

WORKDIR /workspace

RUN mkdir -p /config /data/db /data/downloads

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download && \
    cp -a /go/pkg/mod /opt/go-mod-cache

COPY web/package.json web/package-lock.json ./web/
RUN --mount=type=cache,target=/root/.npm \
    npm --prefix web ci

COPY . .

ENV SERVER_ADDR=:8080 \
    DATA=/data \
    DB_DRIVER=sqlite \
    GOMODCACHE=/opt/go-mod-cache

EXPOSE 8080 5173

CMD ["sh", "-c", "go run ./cmd/server run & backend_pid=$!; npm --prefix web run dev -- --host 0.0.0.0 & frontend_pid=$!; trap 'kill $backend_pid $frontend_pid' INT TERM; wait $backend_pid $frontend_pid"]

FROM development AS test

RUN --mount=type=cache,target=/root/.cache/go-build \
    go test ./...

RUN npm --prefix web run build
