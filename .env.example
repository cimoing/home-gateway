# Optional host ports:
# APP_PORT=8080
# BT_PORT=42069
# TRANSMISSION_RPC_PORT=9091

# Host paths mounted into the container:
# CONFIG_DIR=./config
# DATA_DIR=./data
# TRANSMISSION_CONFIG_DIR=./data/transmission

# Inside the container, DATA=/data is the base for relative paths such as
# db/home-gateway.db and bt/downloads.

# Secrets referenced from /config/config.yaml via ${VAR}:
# SMB_PASSWORD=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CF_API_TOKEN=
# TRANSMISSION_RPC_PASSWORD=

# Optional uid/gid for linuxserver/transmission (compose profile "transmission"):
# PUID=1000
# PGID=1000
# TZ=UTC

