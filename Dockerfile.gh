# syntax=docker/dockerfile:1.7
#
# Build a runtime image from a GitHub Release binary (no local compile).
# Required build-args / env:
#   VERSION  - release tag, with or without leading "v" (e.g. 1.0.0 or v1.0.0)
#   SHA256   - sha256 of the architecture-specific zip asset
# Optional:
#   REPO     - GitHub repository (default: cimoing/home-gateway)

ARG VERSION
ARG SHA256
ARG REPO=cimoing/home-gateway

FROM alpine:3.22 AS downloader

ARG VERSION
ARG SHA256
ARG REPO
ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl unzip

RUN set -eux; \
    if [ -z "${VERSION:-}" ] || [ -z "${SHA256:-}" ]; then \
      echo "VERSION and SHA256 build-args are required" >&2; \
      exit 1; \
    fi; \
    case "${TARGETARCH}" in \
      amd64) arch=amd64 ;; \
      arm64) arch=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    case "${VERSION}" in \
      v*) tag="${VERSION}" ;; \
      *) tag="v${VERSION}" ;; \
    esac; \
    asset="home-gateway-linux-${arch}.zip"; \
    url="https://github.com/${REPO}/releases/download/${tag}/${asset}"; \
    curl -fsSL -o "/tmp/${asset}" "${url}"; \
    echo "${SHA256}  /tmp/${asset}" | sha256sum -c -; \
    mkdir -p /out/app /out/config /out/data/db /out/data/bt/downloads /out/data/bt/.staging; \
    unzip -q "/tmp/${asset}" -d /tmp/release; \
    install -m 0755 "/tmp/release/home-gateway-linux-${arch}/home-gateway" /out/app/home-gateway; \
    if [ -f "/tmp/release/home-gateway-linux-${arch}/config.example.yaml" ]; then \
      cp "/tmp/release/home-gateway-linux-${arch}/config.example.yaml" /out/config/config.yaml; \
    fi; \
    touch /out/data/.keep /out/config/.keep

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

COPY --from=downloader --chown=nonroot:nonroot /out/app/home-gateway ./home-gateway
COPY --from=downloader --chown=nonroot:nonroot /out/config /config
COPY --from=downloader --chown=nonroot:nonroot /out/data /data

ENV GIN_MODE=release \
    SERVER_ADDR=:8080 \
    DATA=/data \
    DB_DRIVER=sqlite

EXPOSE 8080 42069/tcp 42069/udp

VOLUME ["/config", "/data"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["/app/home-gateway"]
CMD ["run"]
